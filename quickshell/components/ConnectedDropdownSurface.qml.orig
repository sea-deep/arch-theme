import QtQuick
import QtQuick.Shapes
import "../theme"

Shape {
    id: root

    property real tabWidth: Theme.compactPillSize
    property bool tabOnLeft: false
    readonly property real inset: Theme.borderWidth / 2
    readonly property real bodyTop: Theme.barHeight + Theme.outerGap
    readonly property real bodyExtent: Math.max(0, height - bodyTop)
    readonly property real bodyCorner: Math.min(Theme.radius, bodyExtent / 2)
    readonly property real tabLeft: width - tabWidth
    readonly property real shoulder: Math.min(Theme.radius,
        Math.max(0, tabLeft - inset) / 2)

    preferredRendererType: Shape.CurveRenderer
    transformOrigin: Item.Center
    scale: tabOnLeft ? -1 : 1

    ShapePath {
        strokeWidth: Theme.borderWidth
        strokeColor: Theme.accent
        fillColor: Theme.bg
        joinStyle: ShapePath.RoundJoin

        startX: root.tabLeft + Theme.radius
        startY: root.inset
        PathLine { x: root.width - Theme.radius; y: root.inset }
        PathQuad {
            controlX: root.width - root.inset
            controlY: root.inset
            x: root.width - root.inset
            y: Theme.radius
        }
        PathLine { x: root.width - root.inset; y: root.height - root.bodyCorner }
        PathQuad {
            controlX: root.width - root.inset
            controlY: root.height - root.inset
            x: root.width - root.bodyCorner
            y: root.height - root.inset
        }
        PathLine { x: root.bodyCorner; y: root.height - root.inset }
        PathQuad {
            controlX: root.inset
            controlY: root.height - root.inset
            x: root.inset
            y: root.height - root.bodyCorner
        }
        PathLine { x: root.inset; y: root.bodyTop + root.bodyCorner }
        PathQuad {
            controlX: root.inset
            controlY: root.bodyTop
            x: root.bodyCorner
            y: root.bodyTop
        }
        PathLine { x: root.tabLeft - root.shoulder; y: root.bodyTop }
        PathQuad {
            controlX: root.tabLeft
            controlY: root.bodyTop
            x: root.tabLeft
            y: root.bodyTop - root.shoulder
        }
        PathLine { x: root.tabLeft; y: Theme.radius }
        PathQuad {
            controlX: root.tabLeft
            controlY: root.inset
            x: root.tabLeft + Theme.radius
            y: root.inset
        }
    }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "theme": {
    "name": "Tokyo Night Miku",
    "slug": "tokyo-night-miku",
    "variant": "dark",
    "author": "sea-deep",
    "description": "Monolithic Tokyo Night theme with Hatsune Miku Teal accents and unified design tokens across Hyprland, Quickshell, GTK, and Qt."
  },
  "colors": {
    "bg": "#1a1b26",
    "bgDark": "#16161e",
    "bgLight": "#24283b",
    "surface": "#2f3549",
    "surfaceVariant": "#3b4261",
    "fg": "#c0caf5",
    "fgDim": "#9aa5ce",
    "fgMuted": "#565f89",
    "accent": "#39c5bb",
    "accentGlow": "#33e0e0",
    "mikuPink": "#e35885",
    "mikuDark": "#134c48",
    "blue": "#7aa2f7",
    "purple": "#bb9af7",
    "red": "#f7768e",
    "orange": "#ff9e64",
    "yellow": "#e0af68",
    "green": "#73daca"
  },
  "typography": {
    "fontFamily": "IBM Plex Sans",
    "fontFamilyMono": "FiraCode Nerd Font",
    "fontWeight": "SemiBold",
    "fontWeightCode": 63,
    "fontWeightQml": 600,
    "fontSizeBase": 10,
    "fontSizeSmall": 8,
    "fontSizeLarge": 12,
    "fontSizeTerminal": 13.0
  },
  "geometry": {
    "barHeight": 38,
    "radius": 11,
    "radiusSmall": 7,
    "radiusLarge": 14,
    "borderWidth": 2,
    "outerGap": 0,
    "moduleSpacing": 6,
    "windowPadding": 12
  },
  "icons": {
    "theme": "YAMIS-enlarged",
    "inheritedThemes": [
      "TokyoNight-Files",
      "Adwaita",
      "AdwaitaLegacy",
      "breeze-dark",
      "hicolor"
    ],
    "cursorTheme": "breeze_cursors",
    "cursorSize": 24
  },
  "wallpaper": {
    "canonical": "/home/dipak/Pictures/wallpapers/satisfaction_hires.png",
    "repoPath": "wallpapers/satisfaction_hires.png"
  },
  "environment": {
    "qtQpaPlatform": "wayland;xcb",
    "qtQpaPlatformTheme": "qt5ct",
    "qtWaylandDisableWindowDecoration": "1",
    "gtkTheme": "adw-gtk3-dark"
  }
}
